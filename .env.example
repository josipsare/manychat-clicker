# Protect your endpoint (any long random string)
AUTH_TOKEN=

# Persistent user-data dir (MUST live on a mounted disk)
USER_DATA_DIR=./data/user-data

# Page part of the URL (the "fb..." segment in your Manychat URLs)
MC_PAGE_ID=

# Port for the web server
PORT=3000

# Headless mode; set to false ONLY for the one-time OAuth login
HEADLESS=true

# Anti-flagging: one window, multiple tabs (recommended). Set to false to use browser pool.
USE_SINGLE_CONTEXT=true
# Max concurrent tabs when using single-context (default 4)
SINGLE_CONTEXT_MAX_TABS=4

# Human-like timing (optional overrides)
# TYPING_BASE_MS=100
# TYPING_VARIANCE_MS=60
# STAGGER_DELAY_MS=2500

# Follow-up log webhook: POST every follow-up outcome (sent/failed) AND crash alerts
# to this URL. Set empty to disable both.
# - Follow-up logs have shape: { type, chatId, pageId, ok, sent, message, ... }
# - Crash alerts have shape:    { event: 'crash', server, kind, message, stack, ... }
# Filter on `event === 'crash'` in your n8n workflow to route crashes to Discord/Slack.
# FOLLOWUP_LOG_WEBHOOK_URL=https://n8n.setty.ai/webhook/FUs-logs

# Friendly name shown in crash/dedup alerts so you know which VPS is reporting.
# SERVER_NAME=manychat-clicker
# At most one crash alert per this many ms (prevents spam during error bursts).
# CRASH_NOTIFICATION_RATE_LIMIT_MS=60000
# At most one dedup-blocked alert per this many ms. Suppressed counts roll into the next alert.
# DEDUP_NOTIFICATION_RATE_LIMIT_MS=300000

# Deduplication window for identical requests (default 10 minutes).
# Identical request bodies (or same Idempotency-Key header) within this window
# return the cached result instead of running again. Stops n8n retries from
# producing duplicate sends.
# DEDUP_WINDOW_MS=600000

# ---- Multi-VPS / cookie sync (only set on worker VPSs, not the master) ----
# URL of the session-master VPS. Workers pull cookies from this URL on startup
# and periodically. Leave empty on the master itself or in single-VPS mode.
# COOKIE_SYNC_MASTER_URL=http://session-master.internal:3000
# How often workers re-pull cookies from the master (default 30 minutes).
# COOKIE_SYNC_INTERVAL_MS=1800000
# Bearer token used to authenticate to the master's /get-session.
# Defaults to AUTH_TOKEN. Set explicitly only if master uses a different token.
# COOKIE_SYNC_AUTH_TOKEN=
