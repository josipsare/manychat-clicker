# Port the router listens on (n8n calls this URL via the Cloudflare tunnel)
PORT=8080

# Comma-separated list of backend manychat-clicker servers.
# Each backend must expose /healthz and /press.
# Add more here when you scale; the router will spread traffic across all healthy
# backends using least-loaded routing.
BACKENDS=https://manychat-backend.setty.ai

# How often the router probes each backend's /healthz (ms).
HEALTH_CHECK_INTERVAL_MS=15000

# Health check request timeout (ms).
HEALTH_CHECK_TIMEOUT_MS=5000

# How long to keep a forwarded request open waiting for the backend (ms).
# Must be longer than the backend's JOB_TIMEOUT_MS (default 420000 = 7 min).
PROXY_TIMEOUT_MS=600000

# Affinity cache TTL: how long the router remembers which backend a particular
# request fingerprint went to. Identical retries within this window go to the
# same backend — critical so the backend's per-backend dedup actually catches
# retries. Match the backend's DEDUP_WINDOW_MS for consistency.
AFFINITY_TTL_MS=600000
